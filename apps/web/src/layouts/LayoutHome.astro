---
// LayoutHome.astro
// Layout ACCUEIL : splash screen UNIQUEMENT à la première visite de la session

import SplashScreen from '../components/Animation.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="description" content="Mémoire Vive - A Tribute to Disappeared Journalists" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
</head>
<body class="page-transition-in">
<!-- SplashScreen UNIQUEMENT à la première visite (détecté via sessionStorage) -->
<SplashScreen showSplash={true} />

<!-- Contenu principal avec transition fade-in -->
<main class="content-fade-in">
  <slot />
</main>
</body>
</html>

<style is:global>
  /* Transition de page : fade out avant navigation */
  html.page-leaving {
    animation: pageTransitionOut 0.5s ease-in-out forwards;
  }

  /* Transition de page : fade in à l'arrivée */
  body.page-transition-in {
    animation: pageTransitionIn 0.5s ease-in-out forwards;
  }

  /* Animation d'entrée du contenu */
  .content-fade-in {
    animation: contentFadeIn 0.6s ease-out forwards;
    animation-delay: 0.2s;
  }

  @keyframes pageTransitionOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes pageTransitionIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes contentFadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Gérer les transitions entre pages
  document.addEventListener('astro:before-preparation', () => {
    document.documentElement.classList.add('page-leaving');
  });

  document.addEventListener('astro:after-swap', () => {
    document.documentElement.classList.remove('page-leaving');
    document.body.classList.add('page-transition-in');
  });
</script>